<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Desktop Widgets</AssemblyTitle>
    <Version>0.8.0</Version>
    <!-- Idle desktop widget: favour a small footprint over GC throughput. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <!-- Built-in languages; files in a languages folder next to the exe add more or override these. -->
    <EmbeddedResource Include="Languages\*.json" LogicalName="lang.%(Filename).json" />
  </ItemGroup>

</Project>
